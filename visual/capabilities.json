    "dataViewMappings": [
        {
            "conditions": [
                {
                    "x": {
                        "max": 1
                    },
                    "y": {
                        "max": 1
                    },
                    "z": {
                        "max": 1
                    },
                    "size": {
                        "max": 1
                    },
                    "category": {
                        "max": 1
                    },
                    "tooltip": {
                        "max": 10
                    }
                }
            ],
            "categorical": {
                "categories": {
                    "for": {
                        "in": "category"
                    },
                    "dataReductionAlgorithm": {
                        "window": {
                            "count": 10000
                        }
                    }
                },
                "values": {
                    "select": [
                        {
                            "bind": {
                                "to": "x"
                            }
                        },
                        {
                            "bind": {
                                "to": "y"
                            }
                        },
                        {
                            "bind": {
                                "to": "z"
                            }
                        },
                        {
                            "bind": {
                                "to": "size"
                            }
                        },
                        {
                            "bind": {
                                "to": "tooltip"
                            }
                        }
                    ],
                    "dataReductionAlgorithm": {
                        "window": {
                            "count": 10000
                        }
                    }
                }
            }
        }
